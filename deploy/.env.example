WEEKLY_VERSION=0.281.0
WEEKLY_POSTGRES_DSN=postgres://weekly:CHANGE_ME@postgres.example.internal:5432/weekly?sslmode=require
# 아래 2개는 관리자 계정이 없는 첫 기동에만 필요합니다.
# 최초 관리자가 만들어진 뒤에는 다시 읽히지 않으니 이 파일에서 지우십시오.
WEEKLY_BOOTSTRAP_ADMIN=admin
WEEKLY_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARS
# 필수. 운영 최초 1회 `openssl rand -base64 32`로 생성하고 업그레이드 때도 같은 값을 유지합니다.
# 이 값을 잃어버리면 OIDC Client Secret, AI API Key, Confluence 비밀번호를 복호화할 수 없습니다.
# 값을 비우면 키가 상태 볼륨에만 저장되어 볼륨이 사라질 때 비밀 설정을 함께 잃습니다.
WEEKLY_ENCRYPTION_KEY=
# 비밀 설정을 복호화할 수 없는 상태에서 기동을 강행하고 모두 다시 입력할 때만 true로 설정합니다.
WEEKLY_ALLOW_SECRET_RESET=false
